SQLITE_API int sqlite3_gogoke_bind_main_handle(
  void *pHandle,
  const char *zPath,
  int createdNew,
  int readWrite,
  unsigned long long rootVolume,
  const unsigned char *pRootFileId,
  int rootFileIdLength
){
  HANDLE h = (HANDLE)pHandle;
  DWORD ownerThreadId = GetCurrentThreadId();
  if( InterlockedCompareExchange(&gogokeRouteBStrict, 0, 0)==0
   || ownerThreadId!=(DWORD)InterlockedCompareExchange(
        &gogokeRouteBStrictOwnerThreadId, 0, 0)
   || zPath==0 || zPath[0]==0 || gogokeRouteBPathHasUriQuery(zPath)
   || pRootFileId==0 || rootFileIdLength!=16
   || !gogokeRouteBHandleAdmissible(h, readWrite) ){
    return SQLITE_MISUSE_BKPT;
  }
  if( InterlockedCompareExchange(&gogokeRouteBPending, 1, 0)!=0 ){
    return SQLITE_BUSY;
  }
  gogokeRouteBHandshake.zPath = sqlite3_mprintf("%s", zPath);
  if( gogokeRouteBHandshake.zPath==0 ){
    InterlockedExchange(&gogokeRouteBPending, 0);
    return SQLITE_NOMEM_BKPT;
  }
  gogokeRouteBHandshake.h = h;
  gogokeRouteBHandshake.createdNew = createdNew!=0;
  gogokeRouteBHandshake.readWrite = readWrite!=0;
  gogokeRouteBHandshake.rootVolume = rootVolume;
  memcpy(gogokeRouteBHandshake.rootFileId, pRootFileId, 16);
  gogokeRouteBHandshake.ownerThreadId = ownerThreadId;
  gogokeRouteBHandshake.generation = (unsigned long)InterlockedIncrement(&gogokeRouteBGeneration);
  InterlockedExchange(&gogokeRouteBLastOwnerGeneration,
                      (LONG)gogokeRouteBHandshake.generation);
  return SQLITE_OK;
}

SQLITE_API unsigned long sqlite3_gogoke_owner_generation(void){
  if( GetCurrentThreadId()!=(DWORD)InterlockedCompareExchange(
        &gogokeRouteBStrictOwnerThreadId, 0, 0) ){
    return 0;
  }
  return gogokeRouteBHandshake.generation;
}

SQLITE_API void *sqlite3_gogoke_cancel_main_handle(
  unsigned long expected_generation
){
  HANDLE h = INVALID_HANDLE_VALUE;
  DWORD ownerThreadId = GetCurrentThreadId();
  if( ownerThreadId!=(DWORD)InterlockedCompareExchange(
        &gogokeRouteBStrictOwnerThreadId, 0, 0) ){
    return 0;
  }
  if( expected_generation!=0
   && gogokeRouteBHandshake.generation!=expected_generation ){
    return 0;
  }
  if( InterlockedCompareExchange(&gogokeRouteBPending, 0, 1)==1 ){
    h = gogokeRouteBHandshake.h;
    gogokeRouteBHandshake.h = INVALID_HANDLE_VALUE;
    if( gogokeRouteBHandshake.zPath!=0 ){
      sqlite3_free(gogokeRouteBHandshake.zPath);
      gogokeRouteBHandshake.zPath = 0;
    }
    /* Keep generation until end_main_open. Session close is owned==expected
    ** only; wiping generation here forced a historical-OR that a stale end
    ** could satisfy. */
  }
  return h==INVALID_HANDLE_VALUE ? 0 : (void*)h;
}

SQLITE_API int sqlite3_gogoke_end_main_open(
  unsigned long expected_generation
){
  unsigned long owned = gogokeRouteBHandshake.generation;
  if( GetCurrentThreadId()!=(DWORD)InterlockedCompareExchange(
        &gogokeRouteBStrictOwnerThreadId, 0, 0) ){
    return SQLITE_MISUSE_BKPT;
  }
  if( owned!=expected_generation ){
    return SQLITE_MISUSE_BKPT;
  }
  if( InterlockedCompareExchange(&gogokeRouteBPending, 0, 0)!=0 ){
    return SQLITE_BUSY;
  }
  InterlockedExchange(&gogokeRouteBStrict, 0);
  InterlockedExchange(&gogokeRouteBStrictOwnerThreadId, 0);
  gogokeRouteBClearHandshake();
  return SQLITE_OK;
}

SQLITE_API unsigned long sqlite3_gogoke_bound_generation(void){
  if( GetCurrentThreadId()!=gogokeRouteBHandshake.ownerThreadId
   || InterlockedCompareExchange(&gogokeRouteBPending, 0, 0)==0 ){
    return 0;
  }
  return gogokeRouteBHandshake.generation;
}

