SQLITE_API int sqlite3_gogoke_get_open_ledger(
  unsigned long long *pAdopted,
  unsigned long long *pStock,
  unsigned long long *pRejected,
  unsigned long long *pCloseSuccess,
  unsigned long long *pCloseUnknown,
  unsigned long long *pLastClosedGeneration
){
  if( pAdopted ) *pAdopted = (unsigned long long)InterlockedCompareExchange(&gogokeRouteBAdopted, 0, 0);
  if( pStock ) *pStock = (unsigned long long)InterlockedCompareExchange(&gogokeRouteBStockMainOpen, 0, 0);
  if( pRejected ) *pRejected = (unsigned long long)InterlockedCompareExchange(&gogokeRouteBRejected, 0, 0);
  if( pCloseSuccess ) *pCloseSuccess = (unsigned long long)InterlockedCompareExchange(&gogokeRouteBCloseSuccess, 0, 0);
  if( pCloseUnknown ) *pCloseUnknown = (unsigned long long)InterlockedCompareExchange(&gogokeRouteBCloseUnknown, 0, 0);
  if( pLastClosedGeneration ) *pLastClosedGeneration = (unsigned long long)InterlockedCompareExchange(&gogokeRouteBLastClosedGeneration, 0, 0);
  return SQLITE_OK;
}

