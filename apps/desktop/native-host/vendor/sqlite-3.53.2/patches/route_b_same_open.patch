SQLITE_API int sqlite3_gogoke_get_close_ledger(
  unsigned long generation,
  unsigned long long *pCalls,
  int *pResult,
  unsigned long *pError
){
  /* Newest-first. The ring is diagnostic; a missing generation is NOTFOUND
  ** and must not be treated as a successful close. Overflow is counted
  ** separately so wrap-around is distinguishable from "never closed". */
  LONG cursor = InterlockedCompareExchange(&gogokeRouteBCloseLedgerCursor, 0, 0);
  unsigned long start = (unsigned long)cursor;
  int i;
  for(i=0; i<GOGOKE_ROUTE_B_CLOSE_LEDGER_SLOTS; i++){
    unsigned long index = (start + GOGOKE_ROUTE_B_CLOSE_LEDGER_SLOTS - 1 - (unsigned long)i)
      % GOGOKE_ROUTE_B_CLOSE_LEDGER_SLOTS;
    GogokeRouteBCloseRecord *p = &gogokeRouteBCloseLedger[index];
    if( (unsigned long)InterlockedCompareExchange(&p->generation, 0, 0)
          == generation ){
      if( pCalls ) *pCalls = (unsigned long long)InterlockedCompareExchange(&p->calls, 0, 0);
      if( pResult ) *pResult = (int)InterlockedCompareExchange(&p->result, 0, 0);
      if( pError ) *pError = (unsigned long)InterlockedCompareExchange(&p->error, 0, 0);
      return SQLITE_OK;
    }
  }
  return SQLITE_NOTFOUND;
}

SQLITE_API unsigned long sqlite3_gogoke_close_ledger_overflow(void){
  return (unsigned long)InterlockedCompareExchange(&gogokeRouteBCloseLedgerOverflow, 0, 0);
}

